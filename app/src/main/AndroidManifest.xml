<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ネットワーク通信（WebSocket/MQTT接続） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service（バックグラウンド動作） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知表示（Android 13以降） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- オーバーレイ表示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JPNKNVox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JPNKNVox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TTS読み上げサービス -->
        <service
            android:name=".JpnknVoxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="tts_reader" />
        </service>

        <!--
            配信アプリ (genkai-broadcaster) へコメントを渡す Bound Service。docs/spec/comment-export-spec.md
            権限で守らない: 両アプリの署名鍵が違うため signature は使えず、normal の自前権限は
            定義側 (このアプリ) が後からインストールされると配信アプリに付与されず bind が拒否された。
            渡すのは公開掲示板・チャットのコメントだけで、こちらへの書き込みの口は無い。
        -->
        <service
            android:name=".export.CommentExportService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.titagaki.genkaibroadcaster.comment.action.COMMENT_SOURCE" />
            </intent-filter>
        </service>
    </application>

</manifest>